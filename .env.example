# API
NODE_ENV=development
PORT=4020
HOST=127.0.0.1
TRUST_PROXY_HOPS=0
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# PostgreSQL (required by production backend)
DATABASE_URL=postgresql://postgres:change-this-password@localhost:5432/mohallamind
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10

# Generate each secret with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
REFRESH_TOKEN_PEPPER=replace-with-a-different-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m

# One-time initial administrator promotion. Disable immediately after use.
ALLOW_ADMIN_BOOTSTRAP=false
ADMIN_BOOTSTRAP_KEY=replace-with-a-random-bootstrap-key-at-least-24-chars

# Azure Blob Storage (private container; no public blob access)
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account_name
AZURE_STORAGE_ACCOUNT_KEY=replace-with-storage-account-key
AZURE_STORAGE_CONTAINER=incident-evidence

# Optional frontend URL if hosting the frontend separately; for single-service Render deployment leave unset.
# VITE_API_BASE_URL=https://your-service.onrender.com
