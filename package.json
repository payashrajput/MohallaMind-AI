{
  "name": "mohallamind-ai",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server:prod\" \"npm:client\"",
    "client": "vite --host 127.0.0.1",
    "server": "node server/production.js",
    "server:prod": "node server/production.js",
    "server:demo": "node server/index.js",
    "dev:demo": "concurrently -k \"npm:server:demo\" \"npm:client\"",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "db:migrate": "node server/migrate.js",
    "start": "node server/production.js",
    "test": "node --test server/tests/*.test.js",
    "test:api": "node --test server/tests/*.test.js",
    "check": "node --check server/production.js && node --check server/migrate.js && node --check server/index.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "vite": "6.4.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "lucide-react": "0.468.0",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "multer": "^2.0.2",
    "concurrently": "^9.1.2",
    "pg": "^8.13.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.5.0",
    "zod": "^3.24.1",
    "dotenv": "^16.4.7",
    "@azure/storage-blob": "^12.26.0",
    "sharp": "^0.33.5"
  },
  "engines": {
    "node": ">=20.19.0 <23"
  }
}
